{
  "Urls": "http://localhost:5080",
  "Matchmaking": {
    "SessionExpirationTimeout": "00:00:30",
    "CleanupInterval": "00:00:05",
    "MaxActiveSessions": 1000,
    "MaxSessionsPerIp": 10,
    "MaxRequestBodyBytes": 16384,
    "MaxRequestHeadersTotalSize": 8192,
    "MaxAuthorizationHeaderBytes": 1024,
    "MaxConcurrentConnections": 256,
    "DatabasePath": "data/matchmaking.db",
    "Tokens": {
      "Issuer": "matchmaking-service",
      "ApiAudience": "matchmaking-api",
      "AuthSigningKeyPath": "keys/mm-auth-signing.pem",
      "NatSigningKeyPath": "keys/mm-nat-signing.pem",
      "AuthTokenLifetime": "01:00:00",
      "ClientTokenLifetime": "00:02:00",
      "HostTokenLifetime": "1.00:00:00",
      "OwnerTokenLifetime": "00:02:00"
    },
    "LoginProtection": {
      "MaxFailedAttempts": 5,
      "FailureWindow": "00:15:00",
      "LockoutDuration": "00:15:00",
      "MaxTrackedEmails": 100000
    },
    "RateLimits": {
      "GlobalPermitLimit": 600,
      "GlobalWindow": "00:01:00",
      "CreatePermitLimit": 5,
      "CreateWindow": "00:01:00",
      "ListPermitLimit": 60,
      "ListWindow": "00:01:00",
      "HeartbeatPermitLimit": 30,
      "HeartbeatWindow": "00:01:00",
      "DeletePermitLimit": 10,
      "DeleteWindow": "00:01:00",
      "RegisterPermitLimit": 5,
      "RegisterWindow": "00:01:00",
      "LoginPermitLimit": 10,
      "LoginWindow": "00:01:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
